# Kopiera till remote.env och fyll i för KLICK-FRI utrullning.
#   cp remote.env.example remote.env  &&  nano remote.env
# remote.env är gitignore:ad → dessa hemligheter hamnar ALDRIG i repot.
# Alla rader är valfria: utan dem faller skriptet tillbaka till interaktiv
# Tailscale-inloggning (länk) och ett slumpat RustDesk-lösen.

# --- Tailscale auth-nyckel → anslut utan inloggningslänk ---
# Skapa på: https://login.tailscale.com/admin/settings/keys
#   välj "Reusable" (funkar på flera NUC:ar) — ev. sätt en tag, lämna "Ephemeral" av.
#TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# Enhetens namn i Tailscale (annars används datorns hostname).
#TS_HOSTNAME=flykten-1

# --- SSH-nyckel → logga in utan lösenord ---
# Klistra in HELA raden ur din publika nyckel på Macen:  cat ~/.ssh/id_ed25519.pub
# OBS: inom "citattecken" (nyckeln innehåller mellanslag).
#SSH_PUBKEY="ssh-ed25519 AAAAC3Nza... josef@mac"

# --- RustDesk ---
# Fast lösen (annars slumpas ett unikt per NUC och skrivs ut/sparas lokalt).
#RUSTDESK_PW=

# --- VNC (setup-vnc.sh) ---
# Lösenord för skärmdelning. Max 8 ASCII-tecken, inga å/ä/ö (VNC-protokollets gräns).
# Sätts ej → setup-vnc.sh frågar interaktivt.
#VNC_PW=kiosk123
